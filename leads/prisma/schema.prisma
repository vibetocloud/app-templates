generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id        String    @id @default(uuid())
  name      String
  email     String
  company   String?
  message   String
  createdAt DateTime  @default(now())
  handledAt DateTime?
  isDemo    Boolean   @default(false)

  @@index([handledAt, createdAt])
}
