generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Visit {
  id          String    @id @default(uuid())
  name        String
  company     String?
  host        String
  signedInAt  DateTime  @default(now())
  signedOutAt DateTime?
  isDemo      Boolean   @default(false)

  @@index([signedOutAt, signedInAt])
}
